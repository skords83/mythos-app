generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FamilyRole {
  OWNER
  ADULT
  CHILD
}

enum Visibility {
  PRIVATE
  FAMILY
}

// Entity types that can participate in a generic Relation (Z5).
enum RelatableEntityType {
  CHARACTER
  PLACE
  ITEM
  FACTION
  SCENE
  EVENT
  LORE_ENTRY
}

enum TimelineEventType {
  LORE
  PLOT
}

model Family {
  id         String      @id @default(cuid())
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  members    User[]
  characters Character[]
  places     Place[]
  items      Item[]
  factions   Faction[]
  relations  Relation[]
  placeImages PlaceImage[]
  scenes     Scene[]
  timelineEvents TimelineEvent[]
  loreEntries LoreEntry[]
}

model User {
  id         String      @id @default(cuid())
  email      String      @unique
  name       String?
  password   String    // hashed password
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  projects   Project[]
  familyId   String
  family     Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  role       FamilyRole  @default(ADULT)
  characters Character[]
  places     Place[]
  items      Item[]
  factions   Faction[]
  relations  Relation[]
  placeImages PlaceImage[]
  scenes     Scene[]
  timelineEvents TimelineEvent[]
  loreEntries LoreEntry[]
}

model Project {
  id String @id @default(cuid())
  title String
  description String?
  coverImage String?
  wordGoal Int @default(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters Chapter[]
  characters Character[]
  places Place[]
  items Item[]
  factions Faction[]
  timelineEvents TimelineEvent[]
  loreEntries LoreEntry[]
}

model Chapter {
  id        String   @id @default(cuid())
  title     String
  content   Json?
  order     Int      @default(0)
  wordCount Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notes     Note[]
  scenes    Scene[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Character {
  id          String     @id @default(cuid())
  name        String
  appearance  String?
  personality String?
  backstory   String?
  motivation  String?
  avatarUrl   String?
  visibility  Visibility @default(PRIVATE)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  familyId    String
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  title     String   @default("Neue Notiz")
  content   String
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Place {
  id          String     @id @default(cuid())
  name        String
  description String?
  location    String?
  climate     String?
  importance  String?
  visibility  Visibility @default(PRIVATE)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  familyId    String
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Place?     @relation("PlaceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Place[]    @relation("PlaceHierarchy")
  images      PlaceImage[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// A10: map/visualization images for a Place (1:n). Kept as a plain, directly
// FK'd model rather than routed through the generic Relation (Z5) table
// since it's a single-entity-typed attachment, not a cross-entity edge —
// Prisma/Postgres cascade deletes it automatically when the Place is deleted.
model PlaceImage {
  id        String   @id @default(cuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@index([placeId])
}

model Item {
  id           String     @id @default(cuid())
  name         String
  description  String?
  origin       String?
  significance String?
  visibility   Visibility @default(PRIVATE)
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  familyId     String
  family       Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Faction {
  id          String     @id @default(cuid())
  name        String
  description String?
  goal        String?
  visibility  Visibility @default(PRIVATE)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  familyId    String
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Scene {
  id          String     @id @default(cuid())
  name        String
  description String?
  order       Int        @default(0)
  visibility  Visibility @default(PRIVATE)
  chapterId   String
  chapter     Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  familyId    String
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// B2: standalone chronology of lore- and plot-events, independent of B1
// (Scene). `order` is the manual chronological sort key (like Scene.order);
// `date` is a free-text in-world date/era label since fictional calendars
// don't fit a real DateTime.
model TimelineEvent {
  id          String            @id @default(cuid())
  title       String
  description String?
  date        String?
  order       Int               @default(0)
  type        TimelineEventType @default(PLOT)
  visibility  Visibility        @default(PRIVATE)
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  familyId    String
  family      Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  authorId    String
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// B3: Weltenregeln / Lore-Bibel — atemporal canon facts (magic systems, laws,
// customs) distinct from TimelineEvent's chronological LORE entries. `category`
// is a free-text facet (e.g. "Magie", "Politik", "Religion") rather than an
// enum, matching Item.origin/Faction.goal's free-text convention.
model LoreEntry {
  id          String     @id @default(cuid())
  title       String
  content     String?
  category    String?
  visibility  Visibility @default(PRIVATE)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  familyId    String
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Generic relation/join infrastructure (Z5). A single polymorphic edge type
// shared by future association features (A1 character relationships, A3
// character-place links, A6 faction membership) instead of one bespoke join
// table per feature. `relationType` carries the feature-specific vocabulary
// (e.g. "PARENT_OF", "LIVES_IN", "MEMBER_OF") — Z5 itself is agnostic to it.
//
// No `visibility` field here on purpose: per the Association rule in
// lib/visibility.ts, an edge's visibility is derived live from both
// endpoints, never stored. Referential integrity to Character/Place is
// enforced in application code (see lib/relations.ts), not via Prisma FKs,
// since a single field can't reference more than one model — deleting a
// Character or Place must explicitly clean up its Relation rows too.
model Relation {
  id           String              @id @default(cuid())
  familyId     String
  family       Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  authorId     String
  author       User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sourceType   RelatableEntityType
  sourceId     String
  targetType   RelatableEntityType
  targetId     String
  relationType String
  label        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([familyId, sourceType, sourceId])
  @@index([familyId, targetType, targetId])
}
